# Agenda Cultural Salvador — modelo de configuração.
#
# Copie para .env e preencha.  O arquivo .env NUNCA é versionado
# (.gitignore e .dockerignore já o excluem).
#
# O .env é OPCIONAL para validar o compose (`docker compose config`), mas
# obrigatório para operar: sem BOT_TOKEN o bot sai com código 2 (fail-closed)
# e a publicação permanece bloqueada por AGENDA_ALLOW_EXECUTE=0.
#
# Princípios:
#   * nenhuma credencial real neste arquivo;
#   * tudo é seguro por padrão: sem token o processo recusa iniciar, e a
#     publicação continua em dry-run mesmo com token;
#   * variáveis desconhecidas são ignoradas — não há leitura de config extra.

# ---------------------------------------------------------------------------
# Fuso horário (obrigatório para logs, agendamento e relatórios)
# ---------------------------------------------------------------------------
TZ=America/Bahia

# ---------------------------------------------------------------------------
# Telegram (produção).  Sem BOT_TOKEN o bot NÃO inicia (código de saída 2).
# Sem TARGET_CHAT_ID a publicação real fica bloqueada pelo Publisher.
# ---------------------------------------------------------------------------
# Formato: <id numérico>:<segredo>.  Deixe vazio em desenvolvimento.
BOT_TOKEN=
# Chat/canal de destino, negativo para canais e supergrupos (ex.: -1001234567890).
TARGET_CHAT_ID=
# Base da Bot API — só mude para espelhos/proxies confiáveis.
TELEGRAM_API_BASE=https://api.telegram.org
# Admins iniciais (bootstrap), separados por vírgula.  São promovidos a
# `admin` na inicialização; depois disso o perfil vive no SQLite.
ADMIN_IDS=

# ---------------------------------------------------------------------------
# Banco de dados SQLite (persistente)
# ---------------------------------------------------------------------------
# Dentro do Docker é /app/data/agenda.db (volume nomeado agenda-data).
AGENDA_DB=data/agenda.db

# ---------------------------------------------------------------------------
# Travas de publicação
# ---------------------------------------------------------------------------
# Kill switch de implantação.  Deixe 0 em produção até liberar o go-live.
# Mesmo com 1, ainda é exigida a frase de confirmação digitada por admin.
AGENDA_ALLOW_EXECUTE=0
# Teto de envios por lote (1..10).
AGENDA_MAX_PER_RUN=3
# Intervalo mínimo entre envios reais, em segundos.
AGENDA_MIN_INTERVAL=300

# ---------------------------------------------------------------------------
# Backups (scripts/backup.py + agendador)
# ---------------------------------------------------------------------------
# Diretório dos arquivos .db.gz + .sha256.  Dentro do Docker: /app/backups.
AGENDA_BACKUP_DIR=backups
# Quantos backups diários manter antes de podar os mais antigos.
AGENDA_BACKUP_KEEP=14
# Verificação de integridade (PRAGMA quick_check) após cada backup; mantenha 1.
AGENDA_BACKUP_VERIFY=1

# ---------------------------------------------------------------------------
# Agendamento (scripts/scheduler.py)
# ---------------------------------------------------------------------------
# Caminho do arquivo de agenda (JSON).  Horários são na TZ acima.
AGENDA_SCHEDULE=config/schedule.json
# Estado do agendador (última execução por job), evita disparo duplicado.
AGENDA_SCHEDULER_STATE=data/scheduler_state.json
# 1 = apenas registra o que faria; nenhum job roda de verdade.
AGENDA_SCHEDULER_DRY_RUN=0
# Intervalo do loop do agendador, em segundos (também é o heartbeat).
AGENDA_SCHEDULER_TICK=30
# Janela de recuperação para um horário perdido (processo parado), em horas.
# Acima disso o slot do dia é descartado em vez de rodar fora de hora.
AGENDA_CATCHUP_HOURS=6
# Tempo máximo de uma tarefa antes de ser tratada como falha, em segundos.
AGENDA_TASK_TIMEOUT=1800

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
AGENDA_LOG_LEVEL=INFO
